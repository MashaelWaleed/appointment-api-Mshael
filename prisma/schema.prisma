datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") //مشروع يستخدم الإصدار المستقر والآمن (الإصدار 5).
}

generator client {
  provider = "prisma-client-js"
}

model Appointment {
  id        Int      @id @default(autoincrement())
  userId    String
  startTime DateTime
  endTime   DateTime
  status    String   @default("BOOKED") 
  createdAt DateTime @default(now())
}